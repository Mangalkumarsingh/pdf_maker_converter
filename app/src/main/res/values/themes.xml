<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Generator" parent="Theme.Material3.Light.NoActionBar">

        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>

        <item name="android:statusBarColor">@color/btn_color</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.Generator" parent="Base.Theme.Generator" />

    <style name="FullScreenDialogTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@color/dialog_bar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/dialog_bar_bg</item>
    </style>
</resources>
